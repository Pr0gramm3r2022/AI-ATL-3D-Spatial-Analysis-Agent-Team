from google.adk.agents import BaseAgent
from google.adk.events import Event
from typing import AsyncGenerator
import json

class SpatialAnalysisOrchestrator(BaseAgent):
    """
    Orchestrates 3-agent spatial analysis workflow
    Simple sequential pipeline for solo hackathon
    """
    
    pattern_agent: LlmAgent
    insight_agent: LlmAgent
    report_agent: LlmAgent
    
    model_config = {"arbitrary_types_allowed": True}
    
    def __init__(
        self,
        name: str,
        pattern_agent: LlmAgent,
        insight_agent: LlmAgent,
        report_agent: LlmAgent
    ):
        super().__init__(
            name=name,
            pattern_agent=pattern_agent,
            insight_agent=insight_agent,
            report_agent=report_agent,
            sub_agents=[pattern_agent, insight_agent, report_agent]
        )
    
    async def _run_async_impl(self, ctx) -> AsyncGenerator[Event, None]:
        """
        Simple 3-step pipeline:
        1. Pattern Analysis → 2. Insight Extraction → 3. Report Generation
        """
        
        # Parse input
        request_data = json.loads(ctx.user_content)
        dataset_info = Spatial3DInput(**request_data["dataset"])
        analysis_goal = request_data["analysis_goal"]
        
        yield Event(content=f"🔍 Starting spatial analysis for: {dataset_info.dataset_name}")
        yield Event(content=f"📊 Analysis goal: {analysis_goal}")
        
        # STEP 1: Pattern Analysis
        yield Event(content="\n🎯 STEP 1: Pattern Analysis Agent")
        yield Event(content="  Processing 3D spatial data...")
        
        pattern_input = dataset_info.model_dump_json()
        async for event in self.pattern_agent.run_async(ctx.with_user_content(pattern_input)):
            yield event
            if event.is_final_response:
                pattern_result = PatternAnalysisOutput(**json.loads(event.content.parts[0].text))
                
                yield Event(content=f"\n✓ Pattern Analysis Complete:")
                yield Event(content=f"  • Patterns detected: {len(pattern_result.patterns_detected)}")
                yield Event(content=f"  • Anomalies found: {len(pattern_result.anomalies)}")
                yield Event(content=f"  • Spatial clusters: {len(pattern_result.spatial_clusters)}")
                yield Event(content=f"  • Confidence: {pattern_result.confidence:.2%}")
                yield Event(content=f"  • Tools used: {', '.join(pattern_result.mcp_tools_used)}")
        
        # STEP 2: Insight Extraction
        yield Event(content="\n💡 STEP 2: Insight Extraction Agent")
        yield Event(content="  Analyzing patterns for deeper insights...")
        
        insight_input = InsightInput(
            dataset_info=dataset_info,
            pattern_analysis=pattern_result,
            analysis_goal=analysis_goal
        )
        
        async for event in self.insight_agent.run_async(ctx.with_user_content(insight_input.model_dump_json())):
            yield event
            if event.is_final_response:
                insight_result = InsightExtractionOutput(**json.loads(event.content.parts[0].text))
                
                yield Event(content=f"\n✓ Insight Extraction Complete:")
                yield Event(content=f"  • Key insights: {len(insight_result.key_insights)}")
                yield Event(content=f"  • Correlations: {len(insight_result.correlations_found)}")
                yield Event(content=f"  • Hypotheses: {len(insight_result.hypotheses)}")
                yield Event(content=f"  • Recommendations: {len(insight_result.recommendations)}")
                yield Event(content=f"  • Confidence: {insight_result.confidence:.2%}")
        
        # STEP 3: Report Generation
        yield Event(content="\n📄 STEP 3: Report Generation Agent")
        yield Event(content="  Creating comprehensive analysis report...")
        
        report_input = ReportInput(
            dataset_info=dataset_info,
            pattern_analysis=pattern_result,
            insights=insight_result,
            analysis_goal=analysis_goal
        )
        
        async for event in self.report_agent.run_async(ctx.with_user_content(report_input.model_dump_json())):
            yield event
            if event.is_final_response:
                report_result = ReportGenerationOutput(**json.loads(event.content.parts[0].text))
                
                yield Event(content=f"\n✓ Report Generation Complete:")
                yield Event(content=f"  • Title: {report_result.report_title}")
                yield Event(content=f"  • Visualizations: {len(report_result.visualizations)}")
                yield Event(content=f"  • Conclusions: {len(report_result.conclusions)}")
                yield Event(content=f"  • Report URL: {report_result.report_url}")
        
        yield Event(content="\n🎉 Analysis Complete!")
        yield Event(content=f"\nFinal Report: {report_result.report_url}")


