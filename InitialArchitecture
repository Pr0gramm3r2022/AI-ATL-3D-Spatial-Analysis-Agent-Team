# shared/schemas.py - SIMPLE 3-AGENT SCHEMAS
# ============================================
from pydantic import BaseModel, Field, validator
from typing import Optional, List, Dict, Literal
from datetime import datetime

class Spatial3DInput(BaseModel):
    """Input: 3D spatial dataset"""
    dataset_id: str
    dataset_name: str
    dataset_type: Literal[
        "point_cloud",
        "depth_map", 
        "lidar_scan",
        "satellite_imagery",
        "mesh_3d"
    ]
    file_url: str  # Cloud Storage URL
    metadata: Dict = Field(default_factory=dict)
    analysis_type: Literal[
        "anomaly_detection",
        "pattern_recognition",
        "change_detection",
        "density_analysis",
        "feature_extraction"
    ]
    timestamp: str = Field(default_factory=lambda: datetime.utcnow().isoformat())

class AnalysisRequest(BaseModel):
    """Request for spatial analysis"""
    dataset_id: str
    analysis_goal: str = Field(
        ..., 
        description="What user wants to learn from the data"
    )
    comparison_dataset_id: Optional[str] = None  # For change detection
    output_format: Literal["report", "visualization", "both"] = "both"

class PatternAnalysisOutput(BaseModel):
    """Output from Pattern Analysis Agent"""
    patterns_detected: List[Dict] = Field(default_factory=list)
    anomalies: List[Dict] = Field(default_factory=list)
    spatial_clusters: List[Dict] = Field(default_factory=list)
    statistical_summary: Dict
    key_findings: List[str]
    confidence: float = Field(..., ge=0, le=1)
    processing_time_seconds: float
    mcp_tools_used: List[str] = Field(default_factory=list)

class InsightExtractionOutput(BaseModel):
    """Output from Insight Extraction Agent"""
    key_insights: List[str]
    contextual_analysis: str
    correlations_found: List[Dict] = Field(default_factory=list)
    hypotheses: List[str] = Field(default_factory=list)
    recommendations: List[str]
    confidence: float = Field(..., ge=0, le=1)
    reasoning: str
    mcp_tools_used: List[str] = Field(default_factory=list)

class ReportGenerationOutput(BaseModel):
    """Output from Report Generation Agent"""
    report_title: str
    executive_summary: str
    detailed_analysis: str
    visualizations: List[Dict] = Field(default_factory=list)
    data_tables: List[Dict] = Field(default_factory=list)
    conclusions: List[str]
    next_steps: List[str]
    report_url: Optional[str] = None  # Cloud Storage URL
    mcp_tools_used: List[str] = Field(default_factory=list)


